# Copy to .env (which git ignores) and fill in.
GEMINI_API_KEY=

# Optional: override the model IDs. Run `uv run lab models` to see which ones your key can use.
# AGENTLAB_FLASH_MODEL=gemini-3.8-flash
# AGENTLAB_FLASH_LITE_MODEL=gemini-3.5-flash-lite

# Optional: where runs are saved (default .agentlab/lab.db, which git ignores).
# AGENTLAB_DB=.agentlab/lab.db

# Optional: cap Gemini requests per minute (default 15, the free-tier limit for Flash-Lite).
# Raise it on a paid key, or set 0 to turn the limiter off.
# AGENTLAB_RPM=15
